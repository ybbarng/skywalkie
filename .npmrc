# 배포된 지 얼마 안 된 패키지 막기 — 이 프로젝트에서만 끈다
#
# 전역 설정(~/.npmrc)에 "배포 7일이 안 된 패키지는 설치 금지"가 걸려 있다.
# 공급망 공격을 막는 좋은 규칙이지만, Expo SDK는 수십 개 패키지가 함께 배포되고
# 이름 규칙도 제각각이라(expo-*, @expo/*, babel-preset-expo, metro-*)
# 일부만 예외로 두면 버전이 어긋나 빌드가 깨진다.
#
# 대신 이렇게 지킨다.
#   1. pnpm-lock.yaml 을 저장소에 넣어 버전을 고정한다
#   2. 의존성을 새로 넣을 때는 무엇이 들어오는지 확인한다
#   3. 전역 설정은 그대로 두어 다른 프로젝트는 계속 보호받는다
minimum-release-age=0

# 네이티브 모듈이 제대로 연결되려면 의존성이 평평하게 펼쳐져야 한다.
node-linker=hoisted
