{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,

    // 배열이나 객체에서 꺼낸 값이 없을 수도 있음을 강제한다.
    // 처음엔 귀찮지만 "없는 값을 꺼내 쓰는" 실수를 컴파일 단계에서 잡는다.
    // 비행기에서 터질 오류 하나를 미리 막는 값어치가 있다.
    "noUncheckedIndexedAccess": true,

    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,

    // baseUrl 은 TypeScript 7 에서 사라진다. paths 만으로 충분하다.
    "paths": {
      "@/*": ["./src/*"],
      "@test/*": ["./test/*"],
      "@ble/*": ["./modules/ble-peripheral/src/*"],
      "@stayalive/*": ["./modules/stay-alive/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "ios", "android", "dist"]
}
