<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    알리려면 블루투스 저전력 장치가 있어야 한다.

    `required="false"` 인 이유: 없는 기기에서도 앱은 켜져야 한다.
    알리기만 못 할 뿐 찾기와 Wi-Fi 는 그대로 된다. 여기서 앱을
    통째로 못 깔게 만들면 앞뒤가 안 맞는다.
  -->
  <uses-feature
    android:name="android.hardware.bluetooth_le"
    android:required="false" />

</manifest>
